{
  "name": "@jevkit/vitest",
  "version": "0.1.0",
  "description": "Record and replay TypeSafe Jev requests in vitest. Cassettes are .jevl files, so a test recording doubles as a drift golden set.",
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "vitest",
    "testing",
    "cassette",
    "vcr"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjdurden/jevkit-js.git"
  },
  "dependencies": {
    "@jevkit/core": "workspace:^0.2.0"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
